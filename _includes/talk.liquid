---
---
{%- comment -%}
This file should be in _includes/ directory as talk.liquid
It renders a single talk entry, similar to how bib.liquid renders publications
(but bib.liquid is called automatically by jekyll-scholar plugin)
{%- endcomment -%}

<div class="row">
  {% if site.enable_talk_thumbnails %}
    <div class="col col-sm-2 abbr">
      {%- if talk.abbr -%}
        <abbr class="badge rounded w-100">{{ talk.abbr }}</abbr>
      {% endif %}
      {% if talk.preview %}
        {% if talk.preview contains '://' %}
          <img class="preview z-depth-1 rounded" src="{{ talk.preview }}" alt="{{ talk.title }}">
        {% else %}
          {% assign talk_path = talk.preview | prepend: '/assets/img/talks/' %}
          {%
            include figure.liquid
            loading="eager"
            path=talk_path
            sizes = "200px"
            class="preview z-depth-1 rounded"
            zoomable=true
            avoid_scaling=true
            alt=talk.preview
          %}
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  <!-- Talk content -->
  <div id="{{ talk.key }}" class="{% if site.enable_talk_thumbnails %}col-sm-8{% else %}col-sm-10{% endif %}">
    <!-- Title -->
    <div class="title"><strong>{{ talk.title }}</strong></div>
    
    <!-- Speakers -->
    {% if talk.speakers %}
      <div class="author">
        {% assign speaker_array = talk.speakers | split: ", " %}
        {% for speaker in speaker_array %}
          {% if forloop.length > 1 %}
            {% if forloop.first == false %}
              {% if forloop.length > 2 %}, {% elsif forloop.length == 2 %} {% endif %}
            {% endif %}
            {% if forloop.last %}and {% endif %}
          {% endif %}
          
          {% assign is_self = false %}
          {% if site.scholar.last_name %}
            {% for last_name in site.scholar.last_name %}
              {% if speaker contains last_name %}
                {% assign is_self = true %}
              {% endif %}
            {% endfor %}
          {% endif %}
          
          {% if is_self %}
            <u>{{ speaker }}</u>
          {% else %}
            {{ speaker }}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- Venue and date -->
    <div class="periodical">
      {% if talk.venue %}{{ talk.venue }}{% endif %}
      {% if talk.venue and talk.location %}, {% endif %}
      {% if talk.location %}{{ talk.location }}{% endif %}
      {% if talk.venue or talk.location %}{% if talk.date %}, {% endif %}{% endif %}
      {% if talk.date %}{{ talk.date }}{% endif %}
    </div>

    <!-- Description/Note -->
    {% if talk.description %}
      <div class="periodical">
        <em>{{ talk.description }}</em>
      </div>
    {% endif %}

    <!-- Links/Buttons -->
    <div class="links">
      {% if talk.abstract %}
        <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
      {% endif %}
      {% if talk.slides %}
        {% if talk.slides contains '://' %}
          <a href="{{ talk.slides }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% else %}
          <a href="{{ talk.slides | prepend: '/assets/pdf/talks/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% endif %}
      {% endif %}
      {% if talk.video and site.enable_video_embedding %}
        <a class="abstract btn btn-sm z-depth-0" role="button">Video</a>
      {% elsif talk.video %}
        <a href="{{ talk.video }}" class="btn btn-sm z-depth-0" role="button">Video</a>
      {% endif %}
      {% if talk.poster %}
        {% if talk.poster contains '://' %}
          <a href="{{ talk.poster }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% else %}
          <a href="{{ talk.poster | prepend: '/assets/pdf/talks/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% endif %}
      {% endif %}
      {% if talk.website %}
        <a href="{{ talk.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
      {% endif %}
      {% if talk.code %}
        <a href="{{ talk.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
      {% endif %}
      {% if talk.recording %}
        <a href="{{ talk.recording }}" class="btn btn-sm z-depth-0" role="button">Recording</a>
      {% endif %}
    </div>

    {% if talk.abstract %}
      <!-- Hidden abstract block -->
      <div class="abstract hidden">
        <p>{{ talk.abstract }}</p>
      </div>
    {% endif %}

    {% if talk.video and site.enable_video_embedding %}
      <!-- Hidden video block -->
      <div class="abstract hidden">
        <div style="text-align: center;">{% include video.liquid path=talk.video class="img-fluid rounded z-depth-1" controls=true %}</div>
      </div>
    {% endif %}
  </div>
</div>